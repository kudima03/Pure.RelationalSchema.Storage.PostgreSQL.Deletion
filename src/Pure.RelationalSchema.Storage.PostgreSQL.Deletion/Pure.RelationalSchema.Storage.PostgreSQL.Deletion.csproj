<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0-preview.0.2.0</PackageValidationBaselineVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Pure.RelationalSchema.Storage.PostgreSQL.Deletion</PackageId>
    <RootNamespace>Pure.RelationalSchema.Storage.PostgreSQL.Deletion</RootNamespace>
    <AssemblyName>Pure.RelationalSchema.Storage.PostgreSQL.Deletion</AssemblyName>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/kudima03/Pure.RelationalSchema.Storage.PostgreSQL.Deletion</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pure.Collections.Generic" Version="0.1.0-preview.3.0.0" />
    <PackageReference Include="Pure.Primitives" Version="3.7.0" />
    <PackageReference Include="Pure.Primitives.Abstractions" Version="4.3.0" />
    <PackageReference Include="Pure.Primitives.String.Operations" Version="1.5.1" />
    <PackageReference Include="Pure.RelationalSchema.HashCodes" Version="3.3.0" />
    <PackageReference Include="Pure.RelationalSchema.Storage" Version="0.1.0-preview.8.0.0" />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.HashCodes"
      Version="0.1.0-preview.2.2.0"
    />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.PostgreSQL.Abstractions"
      Version="0.1.0-preview.0.1.0"
    />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pure.RelationalSchema.Storage.PostgreSQL.Deletion.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
